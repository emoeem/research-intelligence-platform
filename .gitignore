probe-cargo/target/
probe-cargo/vendor/
/target/
legacy/eri/db/catalog.db*
legacy/eri/cache/
*.pyc
__pycache__/
workers/python/.cache/
workers/.cache/
migrations/platform.db
migrations/platform-fullbatch.db
.rp-workbench-token
migrations/platform.db-*
migrations/platform-search.db
migrations/platform-governance.db
workers/python/.venv/
models/

# Phase 1 临时校验 venv（jsonschema 库级校验用，ROADMAP 2.4 第 1 条，项目目录内非宿主机安装）
.venv-check/

# RTIS kit 运行时产物（knowledge.db 由 bootstrap.sh 从备份或旧 dsh 目录重建，不入库）
integrations/rtis/knowledge.db*
integrations/rtis/data/
integrations/rtis/reports/
integrations/rtis/engagements/
integrations/rtis/current
integrations/rtis/*.log
# pocs/ 运行时落盘（rt.py POCS=HOME/pocs，poc_add 由 knowledge.db content 列
# 物化正文并回填 poc.path，属运行时产物不入库；gitignore 只拦未跟踪新落盘，
# 已跟踪的 kit 快照（迁移提交 022a717，276 个文件）改动仍正常上报）
integrations/rtis/pocs/

# 全局数据库文件不入库（gitignore 只拦未跟踪文件，已跟踪的历史 db 不受影响）
*.db
*.db-shm
*.db-wal
*.db-journal

# 门禁 cwd 兼容自引 symlink（编排 world.run cwd=内层时解析外层相对路径用；
# 环境级工件不入库，见 PHASE2-ACCEPTANCE.md 收口说明）
/research-platform

# RIP 2.0 插件运行时数据根（P6-3 / ROADMAP §7.5.1：rip-data 为运行时数据不入
# 库，目录可经 rip.data_dir/RIP_DATA_DIR 重定位到任意位置，故按目录名全路径
# 级忽略；快照/流水为可再生旁路留存，同 eri.py db 重建口径）
rip-data/

# Playwright 测试输出目录（错误上下文与 trace 等运行时工件，不入库）
web/qa/plugins/.run/
web/qa/visual/.run/

# 仓库根层 node_modules：web 的 npm 依赖只进 web/node_modules（web/.gitignore
# 覆盖）；根层出现的是误跑 npx/vitest 落下的缓存目录（.vite/.vitest-cache），
# 不属于任何交付物，不入库
/node_modules/
