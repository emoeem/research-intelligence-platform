# RIP M7 只读工作台骨架：python:3.12-slim，stdlib-only，无第三方依赖。
# 构建上下文 = apps/server/：
#   podman build -t rp-workbench:m7-skel apps/server
# 运行（数据库以只读卷挂载）：
#   podman run --rm -d --name rp-workbench \
#     -p 127.0.0.1:7800:7800 \
#     -v <repo>/migrations/platform-dryrun.db:/data/platform-dryrun.db:ro \
#     rp-workbench:m7-skel
FROM python:3.12-slim

WORKDIR /app

COPY rp_server.py ./rp_server.py
COPY static/ ./static/

# 容器内必须绑 0.0.0.0 才能被 -p 端口映射访问；宿主机直跑默认仍是 127.0.0.1。
ENV RP_HOST=0.0.0.0 \
    RP_PORT=7800 \
    RP_DB_PATH=/data/platform-dryrun.db

EXPOSE 7800

CMD ["python", "-u", "rp_server.py"]
