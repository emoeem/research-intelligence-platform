# ============================================================================
# rip-tool-base：podman_host 通道首个容器化冒烟工具镜像（P2-5 批次交付物）
# ============================================================================
# 基础镜像 digest 固定（计划 §5.4「镜像固定版本和 digest」）：
#   python:3.12-slim，本机 containers-storage 已有同 digest 实例
#   （podman images --digests 实测 sha256:4840d514c583a4d3d8cad3940e68dee6f0f6f3635c12fcd0a3d74c21a5b93a54），
#   构建全程离线可用；基础镜像更换须重新对账并更新 tool-manifest.yaml 的
#   runtime.image 与 provenance.image_digest。
# 构建命令（宿主机零安装，镜像属运行时数据，ADR §3.2 口径）：
#   podman build -t localhost/rip-tool-base:smoke -f containerfiles/rip-tool-base/Containerfile containerfiles/rip-tool-base/
# 约束落点：非 root 用户与 --userns=keep-id 在运行期由 Adapter 注入
#   （Config.User 实测自动置为宿主 uid:gid，见 podman_host_e2e inspect 断言），
#   本文件不设 USER 指令以免与 keep-id 语义叠加。
FROM docker.io/library/python:3.12-slim@sha256:4840d514c583a4d3d8cad3940e68dee6f0f6f3635c12fcd0a3d74c21a5b93a54

COPY smoke_tool.py /app/smoke_tool.py

# 任务目录挂载点（Adapter 只挂载 workspaces/<run_id> 之下的 in/out，
# 计划 §5.4「只挂载当前任务所需输入和输出目录」；/tmp 由 --tmpfs 提供）。
RUN mkdir -p /task/in /task/out
