{
  "schema_version": "1",
  "kind": "tool",
  "family": "utility",
  "runtime": {
    "type": "podman_host",
    "image": "localhost/rip-tool-coreutils:latest@sha256:c90631b9269d42cb6a7f237dbbfd888f41df970152fd8c8121033089603b2eeb",
    "readonly_rootfs": true,
    "mounts": [
      {
        "role": "input",
        "path": "/task/in",
        "mode": "ro"
      },
      {
        "role": "output",
        "path": "/task/out",
        "mode": "rw"
      }
    ],
    "entrypoint": [
      "python3",
      "/app/core_tools.py",
      "compress"
    ]
  },
  "resources": {
    "cpu": "2",
    "memory": "2Gi",
    "pid_limit": 256,
    "disk_mb": 256,
    "timeout_seconds": 120,
    "max_output_bytes": 1048576
  },
  "network": {
    "mode": "none"
  },
  "secrets": [],
  "permission_level": "T1",
  "health": {
    "probe": {
      "type": "exec",
      "command": [
        "python3",
        "-c",
        "import json; print(json.dumps({'ok': True}))"
      ],
      "timeout_ms": 5000,
      "interval_seconds": 600,
      "degraded_after": 1,
      "broken_after": 3
    },
    "on_run_recover": true
  },
  "provenance": {
    "origin": "rip-native",
    "source_repo": "containerfiles/rip-tool-coreutils（本仓库，自研纯标准库入口）",
    "license": "repo-internal",
    "dependencies": [],
    "image_digest": "sha256:c90631b9269d42cb6a7f237dbbfd888f41df970152fd8c8121033089603b2eeb",
    "known_limits": [
      "untar 固定 filter=data（拒绝绝对路径与 .. 成员）"
    ],
    "tested": "P3-4 批次端到端实测（crates/tool-engine/tests/core_utils_e2e.rs：五 run 经 Gateway::dispatch 全链 + artifact sha256 对账 + 坏输入/截断负例）"
  },
  "context": {
    "summary": "Core Utilities：RIP Core Compress",
    "tags": [
      "utility",
      "podman_host",
      "p3-4"
    ]
  },
  "id": "rip.core.compress",
  "name": "RIP Core Compress",
  "version": "0.1.0",
  "description": "Core Utilities Pack（计划 §14:776）：共用 coreutils 镜像与 core_tools.py 入口（argv op 分派），纯标准库，network.mode=none 纯本地变换：gzip/gunzip/tar/untar（untar 走 tarfile filter=data 防路径穿越）",
  "input_schema": {
    "type": "object",
    "required": [
      "mode",
      "src"
    ],
    "additionalProperties": false,
    "properties": {
      "mode": {
        "type": "string",
        "enum": [
          "gzip",
          "gunzip",
          "tar",
          "untar"
        ]
      },
      "src": {
        "type": "string",
        "description": "/task/in 之下的输入路径（tar 模式支持目录）"
      },
      "dest_name": {
        "type": "string",
        "description": "/task/out 内输出文件名（仅 basename）"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "required": [
      "mode",
      "dest",
      "size_bytes"
    ],
    "properties": {
      "mode": {
        "type": "string"
      },
      "src": {
        "type": "string"
      },
      "dest": {
        "type": "string"
      },
      "size_bytes": {
        "type": "integer"
      },
      "sha256": {
        "type": "string"
      },
      "is_dir": {
        "type": "boolean"
      },
      "tool": {
        "type": "string"
      },
      "elapsed_ms": {
        "type": "integer"
      },
      "uid": {
        "type": "integer"
      }
    }
  },
  "idempotent": false,
  "examples": [
    {
      "input": {
        "mode": "gzip",
        "src": "/task/in/sample.txt"
      },
      "output_hint": {
        "mode": "gzip",
        "dest": "/task/out/sample.txt.gz",
        "size_bytes": 62
      }
    }
  ]
}
