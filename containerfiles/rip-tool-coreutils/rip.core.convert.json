{
  "schema_version": "1",
  "kind": "tool",
  "family": "utility",
  "runtime": {
    "type": "podman_host",
    "image": "localhost/rip-tool-coreutils:latest@sha256:49436f71b66974631ffc4ea7ac805c95bfa07d4d5fb00423c3d5c7ea9b18acaf",
    "readonly_rootfs": true,
    "mounts": [
      {
        "role": "input",
        "path": "/task/in",
        "mode": "ro"
      },
      {
        "role": "output",
        "path": "/task/out",
        "mode": "rw"
      }
    ],
    "entrypoint": [
      "python3",
      "/app/core_tools.py",
      "convert"
    ]
  },
  "resources": {
    "cpu": "2",
    "memory": "2Gi",
    "pid_limit": 256,
    "disk_mb": 256,
    "timeout_seconds": 120,
    "max_output_bytes": 1048576
  },
  "network": {
    "mode": "none"
  },
  "secrets": [],
  "permission_level": "T1",
  "health": {
    "probe": {
      "type": "exec",
      "command": [
        "python3",
        "-c",
        "import json; print(json.dumps({'ok': True}))"
      ],
      "timeout_ms": 5000,
      "interval_seconds": 600,
      "degraded_after": 1,
      "broken_after": 3
    },
    "on_run_recover": true
  },
  "provenance": {
    "origin": "rip-native",
    "source_repo": "containerfiles/rip-tool-coreutils（本仓库，自研纯标准库入口）",
    "license": "repo-internal",
    "dependencies": [],
    "image_digest": "sha256:49436f71b66974631ffc4ea7ac805c95bfa07d4d5fb00423c3d5c7ea9b18acaf",
    "known_limits": [
      "json->csv 要求扁平对象数组；嵌套结构拒绝"
    ],
    "tested": "P3-4 批次端到端实测（crates/tool-engine/tests/core_utils_e2e.rs：五 run 经 Gateway::dispatch 全链 + artifact sha256 对账 + 坏输入/截断负例）"
  },
  "context": {
    "summary": "Core Utilities：RIP Core Convert",
    "tags": [
      "utility",
      "podman_host",
      "p3-4"
    ]
  },
  "id": "rip.core.convert",
  "name": "RIP Core Convert",
  "version": "0.1.0",
  "description": "Core Utilities Pack（计划 §14:776）：共用 coreutils 镜像与 core_tools.py 入口（argv op 分派），纯标准库，network.mode=none 纯本地变换：json 与 csv 互转受限矩阵（json 侧要求扁平对象数组；csv 侧值按字符串保留）",
  "input_schema": {
    "type": "object",
    "required": [
      "from",
      "to"
    ],
    "additionalProperties": false,
    "properties": {
      "from": {
        "type": "string",
        "enum": [
          "json",
          "csv"
        ]
      },
      "to": {
        "type": "string",
        "enum": [
          "json",
          "csv"
        ]
      },
      "src": {
        "type": "string",
        "description": "/task/in 之下的输入文件（与 text 二选一）"
      },
      "text": {
        "type": "string",
        "description": "内联输入（与 src 二选一）"
      },
      "dest_name": {
        "type": "string"
      },
      "delimiter": {
        "type": "string",
        "description": "单字符分隔符，缺省逗号"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "required": [
      "conversion",
      "rows"
    ],
    "properties": {
      "conversion": {
        "type": "string"
      },
      "src": {
        "type": "string"
      },
      "dest": {
        "type": "string"
      },
      "rows": {
        "type": "integer"
      },
      "columns": {
        "type": "array"
      },
      "sha256": {
        "type": "string"
      },
      "tool": {
        "type": "string"
      },
      "elapsed_ms": {
        "type": "integer"
      },
      "uid": {
        "type": "integer"
      }
    }
  },
  "idempotent": false,
  "examples": [
    {
      "input": {
        "from": "json",
        "to": "csv",
        "text": "[{\"a\":1}]"
      },
      "output_hint": {
        "conversion": "json->csv",
        "rows": 1,
        "columns": [
          "a"
        ]
      }
    }
  ]
}
