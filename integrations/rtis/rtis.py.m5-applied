# ── 基础工具 ────────────────────────────────────────────────────────────────
def now_iso() -> str:
    return datetime.now(timezone.utc).astimezone().isoformat(timespec="seconds")


def new_id(prefix: str = "rtis") -> str:
    return f"{prefix}-{datetime.now().strftime('%Y%m%d-%H%M%S')}-{os.getpid() % 10000:04d}"


def jload(path: Path, default: Any = None) -> Any:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return default


def jdump(path: Path, obj: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(obj, ensure_ascii=False, indent=2), encoding="utf-8")
    tmp.replace(path)


def yload(path: Path, default: Any = None) -> Any:
    try:
        return yaml.safe_load(path.read_text(encoding="utf-8"))
    except Exception:
        return default


def log_event(task_id: str, kind: str, payload: dict | None = None) -> None:
    """任务级审计日志（append-only jsonl）。与 k_event 分工：
    k_event 记「知识层发生了什么」，这里记「编排层做了什么」。"""
    p = LOGS_DIR / f"{task_id}.jsonl"
    line = json.dumps({"at": now_iso(), "kind": kind, **(payload or {})}, ensure_ascii=False)
    with p.open("a", encoding="utf-8") as f:
        f.write(line + "\n")


def out(obj: Any) -> None:
    sys.stdout.write(json.dumps(obj, ensure_ascii=False, indent=2) + "\n")


def die(msg: str, code: int = 2) -> None:
    sys.stdout.write(json.dumps({"ok": False, "error": msg}, ensure_ascii=False) + "\n")
    sys.exit(code)


# ── 知识桥（复用 rtis-bridge.js，绝不复制算法）──────────────────────────────
def kb(cmd: str, **kwargs) -> dict:
    if not KB_BRIDGE.exists():
        return {"ok": False, "error": f"知识桥不存在: {KB_BRIDGE}"}
    payload = json.dumps({"cmd": cmd, **kwargs}, ensure_ascii=False)
    try:
        proc = subprocess.run(
            ["node", str(KB_BRIDGE)],
            input=payload.encode("utf-8"),
            capture_output=True,
            timeout=60,
        )
    except Exception as e:  # noqa: BLE001
        return {"ok": False, "error": f"调用知识桥失败: {e}"}
    raw = proc.stdout.decode("utf-8", "replace").strip()
    if not raw:
        return {"ok": False, "error": f"知识桥无输出（stderr={proc.stderr.decode('utf-8','replace')[:300]}）"}
    try:
        return json.loads(raw)
    except Exception:  # noqa: BLE001
        return {"ok": False, "error": f"知识桥输出非 JSON: {raw[:300]}"}


def kb_search(q: str, limit: int = 10, archetype: str = "", type_: str = "") -> dict:
    r = kb("search", q=q, limit=limit, archetype=archetype, type=type_)
    if not r.get("ok"):
        return {"ok": False, "error": r.get("error"), "items": [], "tokens": []}
    return r.get("result", {})


def kb_event(run: str, event: str, kid: int | None = None, payload: dict | None = None) -> None:
    kb("event", run=run, event=event, id=kid, payload=payload or {})


# ── Task ────────────────────────────────────────────────────────────────────
def task_path(task_id: str) -> Path:
    return TASKS_DIR / f"{task_id}.json"


def load_task(task_id: str) -> dict:
    p = task_path(task_id)
    if not p.exists():
        die(f"任务不存在: {task_id}")
    return jload(p)


def save_task(task: dict) -> None:
    task["updated_at"] = now_iso()
    jdump(task_path(task["task"]["id"]), task)


