    task_id = new_id("rtis")
    return {
        "task": {
            "id": task_id,
            "title": (objective[:60] + "…") if len(objective) > 60 else objective,
            "objective": objective,
            "task_type": task_type,
            "target": target,
            "created_at": now_iso(),
            "updated_at": now_iso(),
            "status": "CREATED",
            "skipped_phases": [],
            "status_history": [{"at": now_iso(), "state": "CREATED", "reason": "任务创建"}],
        },
        "authorization": {
            "status": "unconfirmed" if not authorized else "declared",
            "authorized_assets": authorized,
            "excluded_assets": excluded,
            "allowed_actions": [],
            "approval_required": [],
        },
        "environment": {
            "site_profile": {},
            "technologies": [],
            "architecture": {},
            "observations": [],
            "unknowns": [],
        },
        "knowledge": {
            "search_status": "not_started",
            "search_queries": [],
            "matched_entries": [],
            "selected_entries": [],
            "rejected_entries": [],
            "sufficiency": None,
